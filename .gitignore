# Go build outputs (but allow claudechrome-host.exe for distribution)
*.exe~
*.dll
*.so
*.dylib
*.o
*.out
!claudechrome-host.exe

# Go mod (but allow host/go.sum for reproducible builds)
/go.sum
!/host/go.sum

# Node modules
node_modules/
package-lock.json
yarn.lock

# Extension build output
extension/dist/
extension/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.iml

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.build/
*.dist/

# Release packaging output (regenerated from source on demand)
dist-export/
claudechrome-export-*.zip

# Logs
*.log
npm-debug.log*

# Temp
.claude/
.env
.env.local
